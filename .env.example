# ResolveFlow environment
# Copy to .env and fill in. Server-side only — never prefix these with VITE_,
# and never commit the filled-in .env.
#
# The app reads these names from the server environment only — nothing else.
#   local:   this .env file (loaded automatically by `bun run dev`)
#   Netlify: Site settings -> Environment variables (same names, no VITE_ prefix)
# Check what the server actually sees on the Configuration page -> Credentials,
# and prove both connections with the "Test connection" button there.

# --- OpenAI (required) --------------------------------------------------------
# Powers both AI surfaces: the decision engine and the "Flow" case assistant.
# Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: point at Azure OpenAI or a proxy. Defaults to https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- LangSmith tracing (optional) --------------------------------------------
# When LANGSMITH_API_KEY is set, every model call (decisions + chat) is mirrored
# to LangSmith. Leave it empty to disable tracing entirely.
# Create at https://smith.langchain.com/settings
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=resolveflow
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
